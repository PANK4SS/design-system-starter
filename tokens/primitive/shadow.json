{
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": { "color": "#0707071F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    },
    "md": {
      "$type": "shadow",
      "$value": { "color": "#07070724", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }
    },
    "lg": {
      "$type": "shadow",
      "$value": { "color": "#07070733", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }
    }
  }
}
