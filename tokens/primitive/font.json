{
  "font": {
    "family": {
      "display": { "$value": ["Orbitron", "Orbit", "sans-serif"], "$type": "fontFamily" },
      "body":    { "$value": ["Inter", "sans-serif"], "$type": "fontFamily" }
    },
    "size": {
      "100": { "$value": "12px", "$type": "dimension" },
      "200": { "$value": "14px", "$type": "dimension" },
      "300": { "$value": "16px", "$type": "dimension" },
      "400": { "$value": "20px", "$type": "dimension" },
      "500": { "$value": "24px", "$type": "dimension" },
      "600": { "$value": "32px", "$type": "dimension" },
      "700": { "$value": "48px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium":  { "$value": 500, "$type": "fontWeight" },
      "bold":    { "$value": 700, "$type": "fontWeight" },
      "black":   { "$value": 900, "$type": "fontWeight" }
    },
    "line-height": {
      "tight":  { "$value": 1.2, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" }
    }
  }
}
