{
  "extends": ["stylelint-config-recommended"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "color-no-hex": [
      true,
      {
        "message": "Couleur en dur interdite : utiliser un token var(--color-…)"
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Couleur nommée interdite : utiliser un token var(--color-…)"
      }
    ],
    "function-disallowed-list": [
      ["rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch"],
      {
        "message": "Fonction de couleur interdite : utiliser un token var(--color-…)"
      }
    ],
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "background",
        "fill",
        "stroke",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "letter-spacing",
        "border-radius",
        "box-shadow",
        "z-index",
        "gap",
        "row-gap",
        "column-gap",
        "/^padding/",
        "/^margin/",
        "transition-duration",
        "animation-duration"
      ],
      {
        "ignoreValues": [
          "transparent",
          "currentColor",
          "currentcolor",
          "inherit",
          "initial",
          "unset",
          "none",
          "0",
          "auto",
          "normal",
          "1",
          "100%",
          "50%"
        ],
        "expandShorthand": true,
        "message": "Valeur brute interdite pour « ${property} » : utiliser un token var(--…)"
      }
    ],
    "no-descending-specificity": null
  },
  "reportDescriptionlessDisables": true
}
