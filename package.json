{
  "name": "design-system-starter",
  "version": "0.2.0",
  "description": "Starter réutilisable de design system : tokens DTCG générés pour le web, Android et iOS",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./tokens/*": "./dist/web/*",
    "./package.json": "./package.json",
    "./ai/*": "./dist/ai/*"
  },
  "peerDependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "test": "node scripts/check-tokens.mjs",
    "build:tokens": "npm test && node build-tokens.mjs",
    "typecheck": "tsc",
    "storybook": "npm run build:tokens && storybook dev --port 6006 --host 0.0.0.0 --no-open",
    "build:storybook": "npm run build:tokens && storybook build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build": "npm run build:tokens && npm run build:lib && npm run build:manifest",
    "prepack": "npm run build",
    "lint": "oxlint && stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run lint && npm run format:check && npm run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "build:manifest": "node scripts/build-manifest.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "4.10",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.52.0",
    "oxlint": "^1.87.0",
    "playwright": "1.49.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-docgen": "^8.0.4",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
